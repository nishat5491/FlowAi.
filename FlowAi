# ================= CHAT =================
@app.route("/api/chat", methods=["POST"])
def chat():
    if "user" not in session:
        return jsonify({"reply":"Login required"}),403

    if limit(request.remote_addr):
        return jsonify({"reply":"Too many requests"}),429

    data=request.json
    msg=data.get("message","")
    mode=data.get("mode","chat")

    system="Helpful AI"
    if mode=="code": system="Coding expert"
    if mode=="search": system="Short answer"

    try:
        res=requests.post(
            "https://api.openai.com/v1/chat/completions",
            headers={"Authorization":f"Bearer {API_KEY}"},
            json={
                "model":"gpt-4o-mini",
                "messages":[
                    {"role":"system","content":system},
                    {"role":"user","content":msg}
                ]
            }
        )
        reply=res.json()["choices"][0]["message"]["content"]
    except:
        reply="Error"

    # save chat
    conn=sqlite3.connect("flowai.db")
    c=conn.cursor()
    c.execute("INSERT INTO chats VALUES (?,?,?)",(session["user"],msg,reply))
    conn.commit()
    conn.close()

    return jsonify({"reply":html.escape(reply)})

