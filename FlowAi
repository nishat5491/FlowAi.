# ================= DB =================
def init_db():
    conn = sqlite3.connect("flowai.db")
    c = conn.cursor()
    c.execute("CREATE TABLE IF NOT EXISTS users (username TEXT, password TEXT)")
    c.execute("CREATE TABLE IF NOT EXISTS chats (user TEXT, message TEXT, reply TEXT)")
    conn.commit()
    conn.close()
init_db()

# ================= RATE LIMIT =================
req_log = defaultdict(list)
def limit(ip):
    now=time.time()
    req_log[ip]=[t for t in req_log[ip] if now-t<10]
    if len(req_log[ip])>10: return True
    req_log[ip].append(now)
    return False

# ================= LOGIN =================
@app.route("/login", methods=["GET","POST"])
def login():
    if request.method=="POST":
        u=request.form.get("username")
        p=request.form.get("password")

        conn=sqlite3.connect("flowai.db")
        c=conn.cursor()
        c.execute("SELECT * FROM users WHERE username=?", (u,))
        user=c.fetchone()

        if not user:
            c.execute("INSERT INTO users VALUES (?,?)",(u,p))
            conn.commit()
            session["user"]=u
            return redirect("/")

        if user[1]==p:
            session["user"]=u
            return redirect("/")

        return "Wrong password"

    return """
    <h2>FlowAi Login</h2>
    <form method="post">
    <input name="username" placeholder="Username"><br><br>
    <input name="password" type="password" placeholder="Password"><br><br>
    <button>Login</button>
    </form>
    """

@app.route("/logout")
def logout():
    session.clear()
    return redirect("/login")

